# Copy to .env and adjust as needed. See packages/core/src/db/data-source.ts
# for how each variable is used.

# One of: postgres | mysql | better-sqlite3
DAVNODE_DB_TYPE=better-sqlite3

# Used by postgres and mysql.
DAVNODE_DB_HOST=localhost
DAVNODE_DB_PORT=5432
DAVNODE_DB_NAME=davnode
DAVNODE_DB_USER=davnode
DAVNODE_DB_PASSWORD=davnode

# Used by better-sqlite3 only. A file path, or ":memory:" for an ephemeral
# in-memory database.
DAVNODE_DB_FILE=./dev.sqlite
