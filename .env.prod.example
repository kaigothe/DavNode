# Copy to .env.prod and edit. Used by docker-compose.prod.yml, both for
# variable substitution (--env-file .env.prod) and as the app's environment.
# Every variable is documented in the README ("Configuration").

# --- Required ---------------------------------------------------------------
# Public host name; Caddy fetches a certificate for it.
DOMAIN=dav.example.com
# Password of the bundled PostgreSQL database.
POSTGRES_PASSWORD=change-me

# --- Database (the compose file runs PostgreSQL; change only to use another) -
DAVNODE_DB_TYPE=postgres
DAVNODE_DB_HOST=postgres
DAVNODE_DB_PORT=5432
DAVNODE_DB_NAME=davnode
DAVNODE_DB_USER=davnode
# Apply pending migrations when the app starts (default true). Set to false
# if you run them out of band or several instances share one database.
DAVNODE_RUN_MIGRATIONS=true

# --- Authentication ----------------------------------------------------------
# Comma-separated: basic, digest, oauth2. Default: basic.
DAVNODE_AUTH_PROVIDERS=basic
DAVNODE_AUTH_REALM=davnode
# Required with oauth2: JSON array of trusted OIDC issuers, e.g.
# [{"issuer":"https://idp.example.com","audience":"davnode","jwksUri":"https://idp.example.com/jwks"}]
#DAVNODE_OAUTH2_ISSUERS=
# Failed logins per client address and window before answering 429.
#DAVNODE_AUTH_RATE_LIMIT_MAX=10
#DAVNODE_AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# --- Behaviour ---------------------------------------------------------------
# Tenant that /.well-known/caldav and /carddav resolve plain usernames to.
# Leave unset for multi-tenant setups (users then log in as user@tenant).
#DAVNODE_DEFAULT_TENANT=
# Cron expression of the quota reconciliation job (default: daily at 03:00).
#DAVNODE_QUOTA_RECONCILE_CRON=0 3 * * *

# --- Logging -----------------------------------------------------------------
# error | warn | info | debug (default info)
#DAVNODE_LOG_LEVEL=info
