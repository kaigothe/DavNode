{
  // ESM is the module format for this project: Node 22 has mature, stable
  // ESM support, and @davnode/core is meant to be consumable as a library,
  // so its build output should not force a CommonJS-only shape on
  // downstream consumers.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    // Required by TypeORM's decorator-based entity API (@Entity/@Column/...),
    // which still uses the legacy (pre-TC39) decorator signature and relies
    // on emitted design-time type metadata to infer column types.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "types": ["node"]
  }
}
