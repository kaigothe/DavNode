{
  "name": "davnode",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "davnode",
      "license": "AGPL-3.0-only",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@davnode/admin-api": {
      "resolved": "packages/admin-api",
      "link": true
    },
    "node_modules/@davnode/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@davnode/server": {
      "resolved": "packages/server",
      "link": true
    },
    "packages/admin-api": {
      "name": "@davnode/admin-api",
      "version": "0.0.1",
      "license": "AGPL-3.0-only",
      "dependencies": {
        "@davnode/core": "*"
      }
    },
    "packages/core": {
      "name": "@davnode/core",
      "version": "0.0.1",
      "license": "AGPL-3.0-only"
    },
    "packages/server": {
      "name": "@davnode/server",
      "version": "0.0.1",
      "license": "AGPL-3.0-only",
      "dependencies": {
        "@davnode/core": "*"
      }
    }
  }
}
