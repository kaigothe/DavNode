# Copy to .env and edit. Every DAVNODE_* variable is documented in the
# README's "Configuration" section.

# --- Required ---------------------------------------------------------------
# Public host name; Caddy fetches a certificate for it. Use "localhost" for a
# local trial (Caddy then uses its own internal CA).
DOMAIN=dav.example.com
# Password of the bundled PostgreSQL database.
POSTGRES_PASSWORD=change-me

# --- Image version ----------------------------------------------------------
# Pin a release for predictable upgrades; "latest" follows new releases.
DAVNODE_VERSION=latest

# --- Optional ----------------------------------------------------------------
# One organisation: plain user names resolve to this tenant (RFC 6764).
#DAVNODE_DEFAULT_TENANT=demo
# Comma-separated: basic, digest, oauth2.
#DAVNODE_AUTH_PROVIDERS=basic
#DAVNODE_AUTH_RATE_LIMIT_MAX=10
#DAVNODE_AUTH_RATE_LIMIT_WINDOW_MINUTES=15
