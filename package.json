{
  "name": "davnode",
  "version": "1.31.4",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "docs": "npm run build --workspaces && typedoc",
    "bootstrap": "npm run build --workspace=@davnode/core && node packages/core/dist/cli/bootstrap.js",
    "prepare": "husky || true",
    "docs:site": "vitepress build docs",
    "docs:site:dev": "vitepress dev docs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@docsearch/react": {
      "react": "^19.3.1",
      "react-dom": "^19.3.1"
    },
    "@types/react": "^19.3.0",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
